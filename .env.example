# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID администраторов и работников через запятую (узнать можно у @userinfobot)
ADMIN_IDS=123456789,987654321
WORKER_IDS=111222333,444555666

# Публичный URL вашего приложения на Render (без слэша в конце)
MINI_APP_URL=https://your-app.onrender.com

# Строка подключения к базе данных.
# Для теста на Render можно оставить sqlite, для продакшена заменить на PostgreSQL.
DATABASE_URL=sqlite:///./app.db

# Провайдер погоды: openmeteo (бесплатный) или yandex (платный, требует ключ)
WEATHER_PROVIDER=openmeteo

# Если выбран yandex, укажите ключ:
YANDEX_WEATHER_API_KEY=your_yandex_weather_api_key
